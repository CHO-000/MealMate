# Copy this file to .env and fill in real values. Never commit .env.
#
# KKU IntelSphere is OpenAI-compatible: https://gen.ai.kku.ac.th/api/v1
KKU_API_KEY=sk-your-kku-intelsphere-key-here
KKU_BASE_URL=https://gen.ai.kku.ac.th/api/v1
KKU_MODEL=gemini-2.5-flash-lite

# Port the server listens on (Render sets this automatically in production)
PORT=3000
